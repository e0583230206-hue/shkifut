# Backend
SERVER_PORT=3000
SECRET_KEY=supersecretkey
REDIS_ADDR=/app/data/kvrocks.sock
REDIS_PROTOCOL=unix

# Google-oauth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_USERS=example@gmail.com,example1@gmail.com

# Local development only: enables /auth/dev-login (bypasses Google OAuth). Never set in production.
# DEV_LOGIN=true

# Automatic media moderation service (internal URL). Empty = every new image/video stays blurred until a moderator opens it.
MODERATION_URL=http://moderation:8000
