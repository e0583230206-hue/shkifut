# Backend
SERVER_PORT=3000
SECRET_KEY=supersecretkey
REDIS_ADDR=/app/data/kvrocks.sock
REDIS_PROTOCOL=unix

# Google-oauth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_USERS=example@gmail.com,example1@gmail.com

# Local development only: enables /auth/dev-login (bypasses Google OAuth). Never set in production.
# DEV_LOGIN=true

# Automatic media moderation service (internal URL). Empty = every new image/video stays blurred until a moderator opens it.
MODERATION_URL=http://moderation:8000

# Temporary strict mode (backend): 1 = files with people stay fully blurred for readers until a moderator saves the review grid;
# crowd videos are hidden until approved. Default 0. See moderation/README.md
STRICT_UNTIL_REVIEWED=0
# Moderation service: 1 = "likely man" queue for moderators (automatic release unchanged)
DECISION_V2=0
