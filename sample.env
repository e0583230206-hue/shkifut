# Backend
SERVER_PORT=3000
SECRET_KEY=supersecretkey
REDIS_ADDR=/app/data/kvrocks.sock
REDIS_PROTOCOL=unix

# Google-oauth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
ADMIN_USERS=example@gmail.com,example1@gmail.com

# Local development only: enables /auth/dev-login (bypasses Google OAuth). Never set in production.
# DEV_LOGIN=true

# Automatic media moderation service (internal URL). Empty = every new image/video stays blurred until a moderator opens it.
MODERATION_URL=http://moderation:8000

# Temporary strict mode (backend): 1 = files with people stay fully blurred for readers until a moderator saves the review grid;
# crowd videos are hidden until approved. Default 0. See moderation/README.md
STRICT_UNTIL_REVIEWED=0
# Moderation service: 1 = "likely man" queue for moderators (automatic release unchanged)
DECISION_V2=0

# Videos wait for approval (backend, decided at upload time): 1 = a video uploaded from now on is not served to readers
# ("waiting for approval") until an approver presses "approve publication" after watching it as readers see it.
# Images and videos that already exist are not affected. Default 0. See moderation/README.md
HOLD_VIDEOS_UNTIL_APPROVED=0
# People who may review figures and approve videos while the flag is on, in addition to ADMIN_USERS (they must also be moderators)
APPROVER_EMAILS=
# Notification to the private Chat space through the bridge (text only). The bridge answers only from the Docker network, with this key.
BRIDGE_NOTIFY_URL=
BRIDGE_NOTIFY_KEY=

# Ask search engines to stay away from the whole site (X-Robots-Tag, meta noindex, robots.txt "Disallow: /", no sitemap),
# independently of PRIVATE_SITE. Link previews (WhatsApp / social) still work. Default 0.
NOINDEX_SITE=0
