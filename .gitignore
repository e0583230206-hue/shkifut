# Build output / dependencies
frontend/.angular/
frontend/node_modules/
frontend/dist/*
backend/__debug*
backend/*.exe
moderation/__pycache__/
**/__pycache__/

# Environment files and secrets (never commit)
.env
.env.*
*.env
!sample.env

# Runtime data
caddy_data/
caddy_config/
redis_data/
channel_data/
data/
logs/
moderation_models/

# Local-only extra CA certificates (e.g. NetFree) - keep the folder, not the certs
certs/*
!certs/.gitkeep

.ds_store

# Night loop runtime files
night-log.txt
STOP_NIGHT.txt
ALL_DONE.txt
