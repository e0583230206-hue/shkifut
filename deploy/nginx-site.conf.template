# TheChannel ("שקיפות") - nginx site. Generated by deploy/install.sh into
# /etc/nginx/sites-available/__DOMAIN__.conf ; certbot --nginx adds the HTTPS server block.
# Only this file is added; other sites on the server are not touched.

upstream thechannel_backend {
    server 127.0.0.1:__PORT__;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # Uploads (images / videos). Keep in line with the "max_file_size" channel setting (MB).
    client_max_body_size 200m;

    # One canonical address: Google login only accepts the registered redirect URI (https://__DOMAIN__/login).
    if ($host = www.__DOMAIN__) {
        return 301 https://__DOMAIN__$request_uri;
    }

    access_log /var/log/nginx/thechannel.access.log;
    error_log  /var/log/nginx/thechannel.error.log;

    # Live updates (Server-Sent Events): no buffering, long-lived connection.
    location = /api/events {
        proxy_pass http://thechannel_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://thechannel_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;   # stream large uploads to the backend
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
